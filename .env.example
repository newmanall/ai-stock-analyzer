# Alpha Vantage 免费股票行情 API
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# 商汤 SenseNova / OpenAI-compatible LLM API
# 商汤文档 Base URL: https://token.sensenova.cn/v1
LLM_API_KEY=your_sensenova_api_key
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_MODEL=sensenova-6.7-flash-lite

# 当前商汤文档截图未看到 response_format 参数；默认关闭更稳
LLM_RESPONSE_FORMAT_JSON=false

# Supabase 服务端写入配置
# 注意：SERVICE_ROLE_KEY 只能放后端环境变量，不能写到前端代码，也不要提交到 GitHub
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

NODE_ENV=development

# 股票数据缓存时间，单位毫秒。默认 1 小时。
STOCK_CACHE_TTL_MS=3600000
