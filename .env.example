# ============================================
# AI Stock Dashboard - 环境变量配置
# 复制此文件为 .env 并填入你的 API Key
# ============================================

# --- Supabase (必填) ---
# 用于存储搜索历史记录与分析记录
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- 知兔 API (必填) ---
# 用于 K 线历史数据（东方财富备选源）
# 注册: https://www.zhituapi.com
ZHITU_API_TOKEN=your-zhitu-api-token
ZHITU_API_BASE_URL=https://www.zhituapi.com

# --- AI 模型 (必填) ---
# OpenAI 兼容 API（支持 SenseNova / DeepSeek / 智谱等）
OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# --- Alpha Vantage (可选) ---
# 美股数据备用源
# ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# --- 运行模式 ---
NODE_ENV=development
USE_MOCK_STOCK=false
USE_MOCK_AI=false
LLM_RESPONSE_FORMAT_JSON=false