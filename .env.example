# Required for real stock data
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# Required for real LLM analysis
OPENAI_API_KEY=your_openai_or_compatible_llm_key
OPENAI_MODEL=gpt-4o-mini
# Optional: use this for OpenAI-compatible providers, for example DeepSeek, DashScope, Moonshot, etc.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Required for saving analysis records to Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional local/demo switches
# USE_MOCK_AI=true
# USE_MOCK_STOCK=true

NODE_ENV=production
