{
  "name": "ai-stock-dashboard-railway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --config client/vite.config.js --host 0.0.0.0",
    "dev:server": "nodemon server/index.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "check": "node --check server/index.js && node --check server/aiService.js && node --check server/stockService.js && node --check server/supabase.js && node --check server/validators.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.46.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "lucide-react": "^0.468.0",
    "openai": "^4.73.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7",
    "vite": "^6.0.1"
  }
}
